generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shelters_service"]
}

enum ShelterStatus {
  pending
  approved
  rejected
  suspended

  @@schema("shelters_service")
}

model Shelter {
  id          String        @id
  userId      String
  name        String
  description String?       @db.Text
  phone       String?
  email       String?
  website     String?
  ubicacion   String?
  ciudad      String?
  estado      String?
  facebook    String?
  instagram   String?
  twitter     String?
  aprobado    Boolean       @default(false)
  status      ShelterStatus @default(pending)
  logo        String?
  imageUrl    String?

  createdAt DateTime
  updatedAt DateTime

  @@schema("shelters_service")
}
