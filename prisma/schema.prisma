generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shelters_service"]
}

enum ShelterStatus {
  pending
  approved
  rejected
  suspended

  @@schema("shelters_service")
}

model Shelter {
  id           String  @id
  userOwnerId  String
  name         String
  description  String? @db.Text
  phone        String?
  email        String?
  website      String?
  municipality String?
  fullAddress  String?
  schedule     String?
  facebook     String?
  instagram    String?
  twitter      String?
  logo         String?
  imageUrl     String?

  approved Boolean       @default(false)
  status   ShelterStatus @default(pending)

  createdAt DateTime
  updatedAt DateTime

  @@schema("shelters_service")
}
